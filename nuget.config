<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The target branch's library, packed by the benchmark workflow to compare a pull request with. -->
    <add key="benchmark-baseline" value="artifacts/benchmark-baseline" />
    <!--
      AvaloniaEdit with changes not yet released: each control's own dispatcher, undo steps that keep no text area,
      RoutedCommand's focused element held weakly, and the long-line limit as an option. GitHub Packages needs a token,
      from the environment variable NuGetPackageSourceCredentials_AvaloniaEditPreview; see CONTRIBUTING.md.
    -->
    <add key="AvaloniaEditPreview" value="https://nuget.pkg.github.com/OleRoss/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- key value for <packageSource> should match key values from <packageSources> element -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- The released AvaloniaEdit too: a benchmark baseline from a branch without the preview depends on it. -->
      <package pattern="Avalonia.AvaloniaEdit" />
      <package pattern="AvaloniaEdit.TextMate" />
    </packageSource>
    <packageSource key="AvaloniaEditPreview">
      <package pattern="Avalonia.AvaloniaEdit" />
      <package pattern="AvaloniaEdit.TextMate" />
    </packageSource>
    <packageSource key="benchmark-baseline">
      <package pattern="Darp.CodeEditor" />
    </packageSource>
  </packageSourceMapping>
</configuration>
