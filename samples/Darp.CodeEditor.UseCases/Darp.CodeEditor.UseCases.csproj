<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Use cases of the API. Each file is one scenario of a host app; the tests run the sessions of use cases 06 to 08.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>UseCases</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- The app's own logging: the library takes no logger. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharpScript.Runner\Darp.CodeEditor.CSharpScript.Runner.csproj" />
    <!--
      Scripts may use the assemblies of references marked CSharpScriptReference, and publishing deploys them for the
      runner, NativeAOT apps included.
    -->
    <ProjectReference
      Include="..\Darp.CodeEditor.UseCases.ScriptApi\Darp.CodeEditor.UseCases.ScriptApi.csproj"
      CSharpScriptReference="true"
    />
    <!-- The runner side: the app only names its types, for StartAsync and the environments. -->
    <ProjectReference
      Include="..\Darp.CodeEditor.UseCases.ScriptApi.Runner\Darp.CodeEditor.UseCases.ScriptApi.Runner.csproj"
      CSharpScriptReference="true"
    />
  </ItemGroup>
</Project>
