<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Restore then fetches the ReadyToRun compiler, which publish also uses for the C# helpers. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Darp.CodeEditor\Darp.CodeEditor.csproj" />
    <!-- What the Darp.CodeEditor.CSharp package holds: the editor's C#, the script environment, the runner API. -->
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharp\Darp.CodeEditor.CSharp.csproj" />
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharp.Hosting\Darp.CodeEditor.CSharp.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Darp.CodeEditor.Luau\Darp.CodeEditor.Luau.csproj" />
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharp.Execution\Darp.CodeEditor.CSharp.Execution.csproj" />
    <!-- The script.csx globals; the C# server reads the assembly as a file. -->
    <ProjectReference Include="..\Darp.CodeEditor.Demo.Globals\Darp.CodeEditor.Demo.Globals.csproj" />
    <!-- The packet.csx script API, which the runner loads and the C# server reads. -->
    <ProjectReference Include="..\Darp.CodeEditor.Demo.ScriptApi\Darp.CodeEditor.Demo.ScriptApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <!-- The app's Luau API, which luau-lsp loads. -->
    <None Include="..\Shared\Luau\**" LinkBase="Luau" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Puts luau-lsp and the Luau grammar next to the app. -->
  <Import Project="..\..\src\Darp.CodeEditor.Luau\buildTransitive\Darp.CodeEditor.Luau.targets" />
  <!-- Puts the C# helpers next to the app, as the Darp.CodeEditor.CSharp package does. -->
  <Import Project="..\..\src\Darp.CodeEditor.CSharp\buildTransitive\Darp.CodeEditor.CSharp.targets" />
</Project>
