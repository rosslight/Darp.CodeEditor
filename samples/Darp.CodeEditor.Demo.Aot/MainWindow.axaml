<Window
    x:Class="Darp.CodeEditor.Demo.Aot.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:Darp.CodeEditor"
    Title="Code editor demo (NativeAOT, highlighting and search)"
    Width="1200"
    Height="800"
    Background="#1E1E1E"
>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="6,4">
            <Button x:Name="RunButton" Content="Run packet.csx (F5)" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#68217A" Padding="8,3">
            <TextBlock
                x:Name="Status"
                Foreground="White"
                Text="NativeAOT · Ctrl+F to search · JSON has word completion and parse errors"
            />
        </Border>
        <TextBox
            x:Name="RunOutput"
            DockPanel.Dock="Bottom"
            Height="150"
            IsReadOnly="True"
            FontFamily="monospace"
            Background="#252526"
            Foreground="#CCCCCC"
            PlaceholderText="Run the packet script to see its output here"
        />
        <TabControl x:Name="Tabs">
            <TabItem Header="script.luau">
                <editor:CodeEditor x:Name="LuauEditor" DocumentId="script.luau" />
            </TabItem>
            <TabItem Header="config.json">
                <editor:CodeEditor x:Name="JsonEditor" DocumentId="config.json" LanguageId="json" />
            </TabItem>
            <TabItem Header="script.csx">
                <editor:CodeEditor x:Name="CSharpEditor" DocumentId="script.csx" LanguageId="csharp" />
            </TabItem>
            <TabItem x:Name="PacketTab" Header="packet.csx">
                <editor:CodeEditor x:Name="PacketEditor" DocumentId="packet.csx" LanguageId="csharp" />
            </TabItem>
            <TabItem x:Name="BenchTab" Header="bench" IsVisible="False" />
        </TabControl>
    </DockPanel>
</Window>
