<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the sample's scripts see. The app marks it with CSharpScriptReference. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sample.ScriptApi</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Its docs show up in the editor's hover and completion. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bridge's proxies are generated at build time, for NativeAOT. -->
    <PackageReference Include="StreamJsonRpc" />
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharpScript.Runner\Darp.CodeEditor.CSharpScript.Runner.csproj" />
  </ItemGroup>
</Project>
