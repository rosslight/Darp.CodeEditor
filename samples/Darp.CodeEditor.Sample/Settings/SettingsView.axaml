<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:globalization="using:System.Globalization"
    xmlns:local="using:Sample"
    xmlns:settings="using:Sample.Settings"
    x:Class="Sample.Settings.SettingsView"
    x:DataType="local:MainViewModel"
>
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Margin" Value="0,20,0,6" />
            <Setter Property="Theme" Value="{StaticResource BodyStrongTextBlockStyle}" />
        </Style>
        <Style Selector="TextBlock.section.first">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="fa|FASettingsExpander ComboBox, fa|FASettingsExpander fa|FANumberBox">
            <Setter Property="MinWidth" Value="200" />
        </Style>
        <!-- The switches' state in the app's language, rather than the theme's English. -->
        <Style Selector="fa|FASettingsExpander ToggleSwitch" x:DataType="local:MainViewModel">
            <Setter Property="OnContent" Value="{Binding Strings.On}" />
            <Setter Property="OffContent" Value="{Binding Strings.Off}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="24,16,24,24">
        <!-- The cards grow with the window up to 900 px, and stay at the left beyond. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
                <ColumnDefinition Width="0.001*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Classes="section first" Text="{Binding Strings.Appearance}" />
                <fa:FASettingsExpander
                    IconSource="DarkTheme"
                    Header="{Binding Strings.AppTheme}"
                    Description="{Binding Strings.AppThemeDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox ItemsSource="{Binding Settings.AppThemes}" SelectedItem="{Binding Settings.AppTheme}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="settings:ThemeChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Code"
                    Header="{Binding Strings.EditorTheme}"
                    Description="{Binding Strings.EditorThemeDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox
                            ItemsSource="{Binding Settings.EditorThemes}"
                            SelectedItem="{Binding Settings.EditorTheme}"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="settings:ThemeChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Globe"
                    Header="{Binding Strings.Language}"
                    Description="{Binding Strings.LanguageDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox ItemsSource="{Binding Settings.Cultures}" SelectedItem="{Binding Settings.Culture}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="globalization:CultureInfo">
                                    <TextBlock Text="{Binding NativeName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>

                <!--
                  The editor's options, which every editor of the app takes. The choices are the API's values, as VS
                  Code's settings show theirs.
                -->
                <TextBlock Classes="section" Text="{Binding Strings.Editor}" />
                <fa:FASettingsExpander
                    IconSource="Code"
                    Header="{Binding Strings.AutoClosingBrackets}"
                    Description="{Binding Strings.AutoClosingBracketsDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox
                            ItemsSource="{x:Static settings:EditorSettings.AutoClosingModes}"
                            SelectedItem="{Binding Settings.Editor.AutoClosingBrackets}"
                        />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Comment"
                    Header="{Binding Strings.AutoClosingQuotes}"
                    Description="{Binding Strings.AutoClosingQuotesDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox
                            ItemsSource="{x:Static settings:EditorSettings.AutoClosingModes}"
                            SelectedItem="{Binding Settings.Editor.AutoClosingQuotes}"
                        />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Clipboard"
                    Header="{Binding Strings.EmptySelectionClipboard}"
                    Description="{Binding Strings.EmptySelectionClipboardDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.Editor.EmptySelectionClipboard}" />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Find"
                    Header="{Binding Strings.SeedSearchString}"
                    Description="{Binding Strings.SeedSearchStringDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox
                            ItemsSource="{x:Static settings:EditorSettings.SeedSearchStrings}"
                            SelectedItem="{Binding Settings.Editor.SeedSearchStringFromSelection}"
                        />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="SelectAll"
                    Header="{Binding Strings.AutoFindInSelection}"
                    Description="{Binding Strings.AutoFindInSelectionDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox
                            ItemsSource="{x:Static settings:EditorSettings.AutoFindInSelections}"
                            SelectedItem="{Binding Settings.Editor.AutoFindInSelection}"
                        />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Clock"
                    Header="{Binding Strings.HoverDelay}"
                    Description="{Binding Strings.HoverDelayDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <fa:FANumberBox
                            Value="{Binding Settings.Editor.HoverDelay}"
                            Minimum="0"
                            Maximum="10000"
                            SmallChange="50"
                            LargeChange="500"
                            SimpleNumberFormat="F0"
                            SpinButtonPlacementMode="Inline"
                        />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Target"
                    Header="{Binding Strings.MatchBrackets}"
                    Description="{Binding Strings.MatchBracketsDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox
                            ItemsSource="{x:Static settings:EditorSettings.MatchBracketsModes}"
                            SelectedItem="{Binding Settings.Editor.MatchBrackets}"
                        />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Highlight"
                    Header="{Binding Strings.OccurrencesHighlight}"
                    Description="{Binding Strings.OccurrencesHighlightDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.Editor.OccurrencesHighlight}" />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="BulletList"
                    Header="{Binding Strings.ParameterHints}"
                    Description="{Binding Strings.ParameterHintsDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.Editor.ParameterHints}" />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>

                <TextBlock Classes="section" Text="{Binding Strings.About}" />
                <fa:FASettingsExpander
                    IconSource="Help"
                    Header="Darp.CodeEditor"
                    Description="{Binding Strings.AboutDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <HyperlinkButton
                            Content="{Binding Strings.SourceCode}"
                            NavigateUri="https://github.com/rosslight/Darp.CodeEditor"
                        />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
