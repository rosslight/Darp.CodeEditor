<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:globalization="using:System.Globalization"
    xmlns:loc="using:Sample.Localization"
    xmlns:local="using:Sample"
    xmlns:settings="using:Sample.Settings"
    x:Class="Sample.Settings.SettingsView"
    x:DataType="local:MainViewModel"
>
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Margin" Value="0,20,0,6" />
            <Setter Property="Theme" Value="{StaticResource BodyStrongTextBlockStyle}" />
        </Style>
        <Style Selector="TextBlock.section.first">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Button.key-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="fa|FASettingsExpander ComboBox">
            <Setter Property="MinWidth" Value="200" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="24,16,24,24">
        <!-- The cards grow with the window up to 900 px, and stay at the left beyond. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
                <ColumnDefinition Width="0.001*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Classes="section first" Text="{Binding Strings.Appearance}" />
                <fa:FASettingsExpander
                    IconSource="DarkTheme"
                    Header="{Binding Strings.AppTheme}"
                    Description="{Binding Strings.AppThemeDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox ItemsSource="{Binding Settings.AppThemes}" SelectedItem="{Binding Settings.AppTheme}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="settings:ThemeChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <fa:FASettingsExpander
                    IconSource="Globe"
                    Header="{Binding Strings.Language}"
                    Description="{Binding Strings.LanguageDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <ComboBox ItemsSource="{Binding Settings.Cultures}" SelectedItem="{Binding Settings.Culture}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="globalization:CultureInfo">
                                    <TextBlock Text="{Binding NativeName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>

                <TextBlock Classes="section" Text="{Binding Strings.KeyboardShortcuts}" />
                <fa:FASettingsExpander
                    IconSource="Keyboard"
                    Header="{Binding Strings.EditorCommands}"
                    Description="{Binding Strings.EditorCommandsDescription}"
                    ItemsSource="{Binding Settings.Hotkeys.Commands}"
                >
                    <fa:FASettingsExpander.Footer>
                        <Button Content="{Binding Strings.ResetAll}" Click="OnResetAllKeys" />
                    </fa:FASettingsExpander.Footer>
                    <fa:FASettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="settings:CommandHotkey">
                            <Grid ColumnDefinitions="*,Auto,36,36">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    MinWidth="220"
                                    Content="{Binding KeyText}"
                                    Classes.accent="{Binding IsRecording}"
                                    Click="OnRecordKey"
                                    LostFocus="OnRecordKeyLostFocus"
                                />
                                <Button
                                    Grid.Column="2"
                                    Classes="key-action"
                                    IsVisible="{Binding HasKey}"
                                    ToolTip.Tip="{Binding RemoveKey, Source={x:Static loc:Strings.Default}}"
                                    Click="OnRemoveKey"
                                >
                                    <fa:FASymbolIcon Symbol="Dismiss" />
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    Classes="key-action"
                                    IsVisible="{Binding IsChanged}"
                                    ToolTip.Tip="{Binding ResetKey, Source={x:Static loc:Strings.Default}}"
                                    Click="OnResetKey"
                                >
                                    <fa:FASymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </fa:FASettingsExpander.ItemTemplate>
                </fa:FASettingsExpander>

                <TextBlock Classes="section" Text="{Binding Strings.About}" />
                <fa:FASettingsExpander
                    IconSource="Help"
                    Header="Darp.CodeEditor"
                    Description="{Binding Strings.AboutDescription}"
                >
                    <fa:FASettingsExpander.Footer>
                        <HyperlinkButton
                            Content="{Binding Strings.SourceCode}"
                            NavigateUri="https://github.com/rosslight/Darp.CodeEditor"
                        />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
