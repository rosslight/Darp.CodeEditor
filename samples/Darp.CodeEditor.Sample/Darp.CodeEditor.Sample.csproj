<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The sample app: how an Avalonia app uses Darp.CodeEditor. One project for both kinds of app: `dotnet publish -r <rid>`
    publishes it for the JIT, and with `-p:PublishAot=true` added as NativeAOT.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sample</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Reports what NativeAOT can't handle while building, not only when publishing. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Avalonia's own themes, for the windows that try the editor under each of them. -->
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Generates the Strings class of Localization/Strings.resx at build time. -->
    <PackageReference Include="Darp.Utils.ResxSourceGenerator" PrivateAssets="all" />
    <PackageReference Include="FluentAvaloniaUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Darp.CodeEditor\Darp.CodeEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public, as the view model hands the strings to bindings. -->
    <EmbeddedResource Update="Localization\Strings.resx" Public="true" EmitFormatMethods="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's own language, Python, from VS Code's files. -->
    <AvaloniaResource Include="Languages\*.json" />
    <!-- The documents the app starts with, in memory. -->
    <AvaloniaResource Include="Documents\Examples\*" />
    <!-- The examples' JSON schemas, as files next to the app: language servers read schemas by their URIs. -->
    <None Include="Schemas\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    NativeAOT: FluentAvalonia's theme styles the DataGrid, so the DataGrid's code stays in the app although the app shows
    none, with trim and AOT warnings from the reflection its sorting uses. Every other assembly reports its warnings one
    by one; only the DataGrid's are summed up in IL2104 and IL3053, which the app ignores.
  -->
  <PropertyGroup>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>
  <Target Name="SumUpDataGridWarnings" AfterTargets="PrepareForILLink">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'Avalonia.Controls.DataGrid'">
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>
</Project>
