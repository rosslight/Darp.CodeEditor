<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:styling="using:FluentAvalonia.Styling"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:ce="using:Darp.CodeEditor"
    x:Class="Sample.App"
    RequestedThemeVariant="Default"
>
    <Application.Resources>
        <!-- Compact dialogs: a question and its answers, not a page. -->
        <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">420</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">0</x:Double>
        <Thickness x:Key="ContentDialogPadding">20,18,20,16</Thickness>
    </Application.Resources>

    <Application.Styles>
        <styling:FluentAvaloniaTheme />
        <!--
          The editor's styles, after the app's theme. Editors take Light+ or Dark+ by the theme variant, and their popups
          and search bar take the app's look.
        -->
        <ce:CodeEditorStyles />
        <Style Selector="fa|FAContentDialog">
            <Setter Property="TitleTemplate">
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
