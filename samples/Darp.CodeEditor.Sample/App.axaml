<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:styling="using:FluentAvalonia.Styling"
    xmlns:ce="using:Darp.CodeEditor"
    x:Class="Sample.App"
    RequestedThemeVariant="Default"
>
    <Application.Styles>
        <styling:FluentAvaloniaTheme />
        <!--
          The editor's styles, after the app's theme. Editors take Light+ or Dark+ by the theme variant, and their popups
          and search bar take the app's look.
        -->
        <ce:CodeEditorStyles />
    </Application.Styles>
</Application>
