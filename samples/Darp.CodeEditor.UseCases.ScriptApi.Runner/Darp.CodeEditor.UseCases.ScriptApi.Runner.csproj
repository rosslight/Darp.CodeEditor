<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The runner side of the use cases' script API: the session object and the globals. They run only in the JIT runner
    process, so this project is not analysed for NativeAOT: real drivers here may use reflection or native interop. The
    app names these types, which compiles none of their code into a NativeAOT app.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- The docs show up in the editor's hover and completion for scripts. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>UseCases.ScriptApi</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor.UseCases.ScriptApi\Darp.CodeEditor.UseCases.ScriptApi.csproj" />
    <!--
      For IScriptSession and IScriptGlobals, the contracts the runner side implements. The C# package brings the editor
      and Avalonia into the build, but nothing of them loads in the runner: nothing there touches their types.
    -->
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharpScript\Darp.CodeEditor.CSharpScript.csproj" />
  </ItemGroup>
</Project>
