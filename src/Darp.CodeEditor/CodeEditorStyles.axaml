<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ce="using:Darp.CodeEditor"
    xmlns:ae="using:AvaloniaEdit"
    xmlns:popups="using:Darp.CodeEditor.Popups"
    x:Class="Darp.CodeEditor.CodeEditorStyles"
>
    <Styles.Resources>
        <ResourceDictionary>
            <!--
              AvaloniaEdit's control templates, without its Fluent or Simple styles: those read the app theme's resources
              by static lookup, so that an app with the other theme failed to start, and they only color AvaloniaEdit's
              own search panel, completion window and selection, which the editor does not use or colors itself.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AvaloniaEdit/Themes/Base.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The CodeEditorColorTheme resource, per theme variant, comes from the code: XAML cannot key a static value. -->
            <ControlTheme x:Key="{x:Type ce:CodeEditor}" TargetType="ce:CodeEditor">
                <Setter Property="ColorTheme" Value="{DynamicResource CodeEditorColorTheme}" />
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <!-- The search bar goes in here, over the text at the top right, the first time it opens. -->
                        <Panel Name="PART_Root">
                            <ae:TextEditor
                                Name="PART_TextEditor"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                WordWrap="{TemplateBinding WordWrap}"
                                ShowLineNumbers="{TemplateBinding ShowLineNumbers}"
                            />
                        </Panel>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!--
              The scrolling of the popups of code and docs, and their padding: its colors are resources that
              PopupFrame.Paint sets on the frame.
            -->
            <ControlTheme x:Key="{x:Type popups:PopupScrollViewer}" TargetType="popups:PopupScrollViewer">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <popups:PopupDock>
                            <popups:PopupScrollBar Name="PART_VerticalScrollBar" DockPanel.Dock="Right" />
                            <ScrollContentPresenter
                                Name="PART_ContentPresenter"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                            />
                        </popups:PopupDock>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type popups:PopupScrollBar}" TargetType="popups:PopupScrollBar">
                <Setter Property="Width" Value="10" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Track
                            Name="PART_Track"
                            Minimum="{TemplateBinding Minimum}"
                            Maximum="{TemplateBinding Maximum}"
                            Value="{TemplateBinding Value, Mode=TwoWay}"
                            ViewportSize="{TemplateBinding ViewportSize}"
                            Orientation="Vertical"
                            IsDirectionReversed="True"
                        >
                            <Track.DecreaseButton>
                                <popups:PopupTrackButton Name="PART_PageUpButton" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <popups:PopupTrackButton Name="PART_PageDownButton" />
                            </Track.IncreaseButton>
                            <popups:PopupThumb />
                        </Track>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type popups:PopupThumb}" TargetType="popups:PopupThumb">
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Background" Value="{DynamicResource CodeEditorPopupSlider}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <popups:PopupBox Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource CodeEditorPopupSliderHover}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background" Value="{DynamicResource CodeEditorPopupSliderActive}" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type popups:PopupTrackButton}" TargetType="popups:PopupTrackButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <!-- Transparent, not empty: a click on it pages. -->
                        <popups:PopupBox Background="Transparent" />
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
