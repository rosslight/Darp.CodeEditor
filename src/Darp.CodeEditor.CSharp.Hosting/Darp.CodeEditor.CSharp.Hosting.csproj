<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Host apps describe their script environment with this library, including NativeAOT apps. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Ships inside the Darp.CodeEditor.CSharp package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- CSharpHelper: both start the C# helpers the same way. -->
    <InternalsVisibleTo Include="Darp.CodeEditor.CSharp" />
    <InternalsVisibleTo Include="Darp.CodeEditor.CSharp.Execution" />
  </ItemGroup>
</Project>
