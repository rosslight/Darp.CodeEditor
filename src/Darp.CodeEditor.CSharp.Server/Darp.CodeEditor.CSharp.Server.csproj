<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Roslyn Workspaces/Features compose their services with System.Composition (reflection): JIT only. -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Framework-dependent: runs on an installed or per-user .NET runtime. -->
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor.CSharp.Scripting\Darp.CodeEditor.CSharp.Scripting.csproj" />
    <ProjectReference Include="..\Darp.CodeEditor.Lsp\Darp.CodeEditor.Lsp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Darp.CodeEditor.CSharp.Server.Tests" />
  </ItemGroup>
</Project>
