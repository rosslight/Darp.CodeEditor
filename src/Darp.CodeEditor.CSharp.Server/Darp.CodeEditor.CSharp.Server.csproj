<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Roslyn Workspaces/Features compose their services with System.Composition (reflection): JIT only. -->
    <IsAotCompatible>false</IsAotCompatible>
    <!--
      Framework-dependent and portable: the Darp.CodeEditor.CSharp package ships this build output, and an app's publish
      compiles it with ReadyToRun and gives it an app host that runs on the runtime in helpers/dotnet.
    -->
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor.CSharp.Scripting\Darp.CodeEditor.CSharp.Scripting.csproj" />
    <ProjectReference Include="..\Darp.CodeEditor.Lsp\Darp.CodeEditor.Lsp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Darp.CodeEditor.CSharp.Server.Tests" />
  </ItemGroup>
</Project>
