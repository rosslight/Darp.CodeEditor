<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Runs compiled C# scripts in sessions: separate processes with a typed bridge between the app and its scripts.</Description>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeCSharpScriptHelper</TargetsForTfmSpecificContentInPackage>
    <!-- The runner is portable IL under tools/, which an app compiles for its platform when it publishes. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <!-- The helper references this project, so packing builds it rather than referencing it. -->
    <CSharpScriptPackedHelper>..\Darp.CodeEditor.CSharpScript.Runner.Process\Darp.CodeEditor.CSharpScript.Runner.Process.csproj</CSharpScriptPackedHelper>
    <CSharpScriptPackedHelperTargets>Build</CSharpScriptPackedHelperTargets>
    <CSharpScriptPackedHelperBuildsReferences>true</CSharpScriptPackedHelperBuildsReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor.CSharpScript\Darp.CodeEditor.CSharpScript.csproj" />
    <!-- Internal, and shipped by the packages above: the process layer and the compiled script's image. -->
    <ProjectReference Include="..\Darp.CodeEditor.Lsp\Darp.CodeEditor.Lsp.csproj" PrivateAssets="all" />
    <ProjectReference
      Include="..\Darp.CodeEditor.CSharpScript.Protocol\Darp.CodeEditor.CSharpScript.Protocol.csproj"
      PrivateAssets="all"
    />
  </ItemGroup>
  <ItemGroup>
    <!--
      Part of the public API: the bridge's interfaces are StreamJsonRpc contracts, their failures are its exceptions,
      and PolyType shapes describe them for NativeAOT.
    -->
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Darp.CodeEditor.CSharpScript.Runner.Process" />
    <InternalsVisibleTo Include="Darp.CodeEditor.CSharpScript.Tests" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive\*.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <Import Project="..\CSharpScriptHelper.targets" />
</Project>
