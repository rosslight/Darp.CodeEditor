<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Runs compiled C# scripts in a separate process: script handlers, callbacks into the app, deadlines and batching.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor.CSharpScript\Darp.CodeEditor.CSharpScript.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Part of the public API: handlers and services are StreamJsonRpc proxies, their failures are its exceptions, and
      PolyType shapes describe them for NativeAOT.
    -->
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>
</Project>
