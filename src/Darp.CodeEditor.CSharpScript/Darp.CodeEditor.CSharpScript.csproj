<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>C# scripts in Darp.CodeEditor: a host-defined script environment, the C# language server, and compiling scripts to run them.</Description>
    <!-- Not released until the script API is implemented. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor\Darp.CodeEditor.csproj" />
    <ProjectReference Include="..\Darp.CodeEditor.CSharpScript.Protocol\Darp.CodeEditor.CSharpScript.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The C# language, from VS Code. -->
    <AvaloniaResource Include="Languages\*.json" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reads documents' requests and diagnostics in tests, against the real server. -->
    <InternalsVisibleTo Include="Darp.CodeEditor.CSharpScript.Tests" />
  </ItemGroup>
</Project>
