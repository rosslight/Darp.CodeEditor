<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Compiles and runs scripts: needs the JIT. -->
    <IsAotCompatible>false</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Framework-dependent and portable: the Darp.CodeEditor.CSharp package ships this build output, and an app's publish
      compiles it with ReadyToRun and gives it an app host that runs on the runtime in helpers/dotnet.
    -->
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor.CSharp.Execution\Darp.CodeEditor.CSharp.Execution.csproj" />
    <ProjectReference Include="..\Darp.CodeEditor.CSharp.Scripting\Darp.CodeEditor.CSharp.Scripting.csproj" />
  </ItemGroup>
</Project>
