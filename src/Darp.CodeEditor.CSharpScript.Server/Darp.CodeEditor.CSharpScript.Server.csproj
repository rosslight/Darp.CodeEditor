    <!-- Roslyn's workspaces compose themselves with reflection, so the server runs on the JIT. -->
    <CSharpScriptHelperName>csharp-server</CSharpScriptHelperName>
  </PropertyGroup>
  <Import Project="..\CSharpScriptHelper.targets" />
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor.Lsp\Darp.CodeEditor.Lsp.csproj" />
    <ProjectReference Include="..\Darp.CodeEditor.CSharpScript.Protocol\Darp.CodeEditor.CSharpScript.Protocol.csproj" />
  </ItemGroup>
</Project>
