<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Roslyn's workspaces compose themselves with reflection: the server always runs on the JIT. -->
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The app starts it through the dotnet host, or an app host made when the app is published. -->
    <UseAppHost>false</UseAppHost>
    <!-- It stays framework-dependent for a self-contained or NativeAOT app, which starts it and loads none of it. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
    <!--
      An app that publishes passes these to all it references. The libraries the server shares with it keep them, so that
      a parallel build makes one copy of each; the server itself is always a portable JIT build.
    -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Roslyn's messages in English, instead of a dozen folders of resources next to the app. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Darp.CodeEditor.Lsp\Darp.CodeEditor.Lsp.csproj" />
    <ProjectReference Include="..\Darp.CodeEditor.CSharpScript.Protocol\Darp.CodeEditor.CSharpScript.Protocol.csproj" />
  </ItemGroup>
  <!--
    What an app needs of the server next to it, wherever this build put its output: an app's build asks for it, and its
    own output folder may be shared with other projects.
  -->
  <Target Name="GetCSharpScriptServerFiles" DependsOnTargets="ResolveReferences" Returns="@(_ServerFile)">
    <ItemGroup>
      <_ServerOwnFile Include="$(TargetPath);$(ProjectDepsFilePath);$(ProjectRuntimeConfigFilePath)" />
      <_ServerFile Include="@(_ServerOwnFile)" ServerPath="%(_ServerOwnFile.Filename)%(_ServerOwnFile.Extension)" />
      <_ServerDependency Include="@(ReferenceCopyLocalPaths->WithMetadataValue('Extension', '.dll'))" />
      <_ServerFile
        Include="@(_ServerDependency)"
        ServerPath="%(_ServerDependency.DestinationSubDirectory)%(_ServerDependency.Filename)%(_ServerDependency.Extension)"
      />
    </ItemGroup>
  </Target>
</Project>
