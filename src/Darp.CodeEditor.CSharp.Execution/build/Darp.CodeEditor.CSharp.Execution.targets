<Project>
  <!--
    Puts the C# script runner next to the app. Import this file into the app project.

      build     $(OutDir)helpers/csharp-runner/      the runner's build output; it runs on the runtime that runs the app
      publish   $(PublishDir)helpers/csharp-runner/  the runner, framework-dependent and ReadyToRun for $(RuntimeIdentifier)
                $(PublishDir)helpers/dotnet/         the .NET runtime it runs on, laid out as an installed runtime, so
                                                     other helpers, such as the C# language server, can share it

    NativeAOT apps compile their managed assemblies into the executable. Mark the references whose assemblies scripts
    use; publish copies their DLLs next to the app, with StreamJsonRpc and PolyType, which script API assemblies use,
    and every managed assembly those need at run time:

      <ProjectReference Include="..\MyApp.ScriptApi\MyApp.ScriptApi.csproj" CSharpScriptReference="true" />
      <PackageReference Include="MyApp.Devices" CSharpScriptReference="true" />
  -->
  <PropertyGroup>
    <CSharpScriptRunnerProject Condition="'$(CSharpScriptRunnerProject)' == ''"
      >$(MSBuildThisFileDirectory)..\..\Darp.CodeEditor.CSharp.Runner\Darp.CodeEditor.CSharp.Runner.csproj</CSharpScriptRunnerProject>
    <_CSharpScriptRunnerOutput>helpers/csharp-runner/</_CSharpScriptRunnerOutput>
    <_CSharpScriptRuntimeOutput>helpers/dotnet/</_CSharpScriptRuntimeOutput>
    <!-- The runner is framework-dependent and published separately; the app may be self-contained or NativeAOT. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- App publish settings must not reach the runner. -->
    <_CSharpScriptRunnerRemovedProperties>PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained;PublishDir</_CSharpScriptRunnerRemovedProperties>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restores and builds the runner with the app, for the app's RuntimeIdentifier. The app references nothing of it. -->
    <ProjectReference
      Include="$(CSharpScriptRunnerProject)"
      ReferenceOutputAssembly="false"
      Private="false"
      GlobalPropertiesToRemove="$(_CSharpScriptRunnerRemovedProperties)"
    />
  </ItemGroup>

  <Target Name="_GetCSharpScriptRunnerProperties">
    <PropertyGroup>
      <_CSharpScriptRunnerProperties>Configuration=$(Configuration)</_CSharpScriptRunnerProperties>
      <_CSharpScriptRunnerProperties Condition="'$(RuntimeIdentifier)' != ''"
        >$(_CSharpScriptRunnerProperties);RuntimeIdentifier=$(RuntimeIdentifier)</_CSharpScriptRunnerProperties>
    </PropertyGroup>
  </Target>

  <Target
    Name="CopyCSharpScriptRunnerToOutputDirectory"
    AfterTargets="CopyFilesToOutputDirectory"
    DependsOnTargets="_GetCSharpScriptRunnerProperties"
  >
    <MSBuild
      Projects="$(CSharpScriptRunnerProject)"
      Targets="GetTargetPath"
      Properties="$(_CSharpScriptRunnerProperties)"
      RemoveProperties="$(_CSharpScriptRunnerRemovedProperties);TargetFramework"
    >
      <Output TaskParameter="TargetOutputs" ItemName="_CSharpScriptRunnerTargetPath" />
    </MSBuild>
    <ItemGroup>
      <!-- The output is flat; subdirectories hold builds for other runtime identifiers. -->
      <_CSharpScriptRunnerBuildFile Include="%(_CSharpScriptRunnerTargetPath.RootDir)%(Directory)*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_CSharpScriptRunnerBuildFile)"
      DestinationFolder="$(OutDir)$(_CSharpScriptRunnerOutput)"
      SkipUnchangedFiles="true"
    />
  </Target>

  <Target
    Name="_AddCSharpScriptRunnerToPublish"
    AfterTargets="ComputeResolvedFilesToPublishList"
    DependsOnTargets="_GetCSharpScriptRunnerProperties"
  >
    <Error
      Condition="'$(RuntimeIdentifier)' == ''"
      Text="Publishing the C# script runner needs a RuntimeIdentifier, such as -r linux-x64, to bundle its .NET runtime."
    />
    <PropertyGroup>
      <_CSharpScriptRunnerPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'csharp-runner'))</_CSharpScriptRunnerPublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="$(CSharpScriptRunnerProject)"
      Targets="Publish"
      Properties="$(_CSharpScriptRunnerProperties);PublishDir=$(_CSharpScriptRunnerPublishDir)"
      RemoveProperties="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained;TargetFramework"
    />
    <MSBuild
      Projects="$(CSharpScriptRunnerProject)"
      Targets="GetBundledRuntimeFiles"
      Properties="$(_CSharpScriptRunnerProperties);PublishDir=$(_CSharpScriptRunnerPublishDir)"
      RemoveProperties="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained;TargetFramework"
    >
      <Output TaskParameter="TargetOutputs" ItemName="_CSharpScriptRuntimeFile" />
    </MSBuild>
    <ItemGroup>
      <_CSharpScriptRunnerPublishFile Include="$(_CSharpScriptRunnerPublishDir)**" />
      <ResolvedFileToPublish
        Include="@(_CSharpScriptRunnerPublishFile)"
        RelativePath="$(_CSharpScriptRunnerOutput)%(_CSharpScriptRunnerPublishFile.RecursiveDir)%(_CSharpScriptRunnerPublishFile.Filename)%(_CSharpScriptRunnerPublishFile.Extension)"
        CopyToPublishDirectory="PreserveNewest"
      />
      <_CSharpScriptHostFxr
        Include="@(_CSharpScriptRuntimeFile)"
        Condition="'%(_CSharpScriptRuntimeFile.Filename)' == 'hostfxr' or '%(_CSharpScriptRuntimeFile.Filename)' == 'libhostfxr'"
      />
      <ResolvedFileToPublish
        Include="@(_CSharpScriptHostFxr)"
        RelativePath="$(_CSharpScriptRuntimeOutput)host/fxr/%(_CSharpScriptHostFxr.RuntimeVersion)/%(_CSharpScriptHostFxr.Filename)%(_CSharpScriptHostFxr.Extension)"
        CopyToPublishDirectory="PreserveNewest"
      />
      <ResolvedFileToPublish
        Include="@(_CSharpScriptRuntimeFile)"
        Exclude="@(_CSharpScriptHostFxr)"
        RelativePath="$(_CSharpScriptRuntimeOutput)shared/Microsoft.NETCore.App/%(_CSharpScriptRuntimeFile.RuntimeVersion)/%(_CSharpScriptRuntimeFile.DestinationSubPath)"
        CopyToPublishDirectory="PreserveNewest"
      />
    </ItemGroup>

    <!--
      NativeAOT compiles the app's managed assemblies into the executable; scripts need the marked ones as files, and the
      runner needs everything they use at run time: their managed dependencies, transitively, from the app's own
      assemblies. The app's runtime pack stays out; the runner has its own runtime.
    -->
    <ItemGroup Condition="'$(PublishAot)' == 'true'">
      <!-- What the app marked: project references as they are written, packages by ID. -->
      <_CSharpScriptReferenceKey Include="@(ProjectReference->WithMetadataValue('CSharpScriptReference', 'true'))" />
      <_CSharpScriptReferenceKey Include="@(PackageReference->WithMetadataValue('CSharpScriptReference', 'true'))" />
      <_CSharpScriptReferenceKey Include="StreamJsonRpc;PolyType" Condition="'@(_CSharpScriptReferenceKey)' != ''" />
      <_CSharpScriptReferenceCandidate
        Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == '' and !$([System.String]::new('%(ReferenceCopyLocalPaths.NuGetPackageId)').Contains('.App.Runtime.'))"
        SourcePath="%(ReferenceCopyLocalPaths.FullPath)"
        Key="%(ReferenceCopyLocalPaths.ProjectReferenceOriginalItemSpec)%(ReferenceCopyLocalPaths.NuGetPackageId)"
      />
      <_CSharpScriptReferenceByKey Include="@(_CSharpScriptReferenceCandidate->'%(Key)')" />
      <_CSharpScriptReferenceUnmarked Include="@(_CSharpScriptReferenceByKey)" Exclude="@(_CSharpScriptReferenceKey)" />
      <_CSharpScriptReferenceMarked
        Include="@(_CSharpScriptReferenceByKey)"
        Exclude="@(_CSharpScriptReferenceUnmarked)"
      />
      <_CSharpScriptReferenceRoot Include="@(_CSharpScriptReferenceMarked->'%(SourcePath)'->Distinct())" />
    </ItemGroup>
    <ResolveAssemblyReference
      Condition="'@(_CSharpScriptReferenceRoot)' != ''"
      AssemblyFiles="@(_CSharpScriptReferenceRoot)"
      CandidateAssemblyFiles="@(_CSharpScriptReferenceCandidate)"
      SearchPaths="{CandidateAssemblyFiles}"
      AllowedAssemblyExtensions=".dll"
      FindDependencies="true"
      FindSatellites="false"
      FindSerializationAssemblies="false"
      FindRelatedFiles="false"
      AutoUnify="true"
      Silent="true"
    >
      <Output TaskParameter="ResolvedDependencyFiles" ItemName="_CSharpScriptReferenceDependency" />
    </ResolveAssemblyReference>
    <ItemGroup Condition="'$(PublishAot)' == 'true'">
      <_CSharpScriptReferenceFile Include="@(_CSharpScriptReferenceRoot);@(_CSharpScriptReferenceDependency->'%(FullPath)')" />
      <_CSharpScriptReferenceFile Remove="@(_CSharpScriptReferenceFile)" Condition="'%(Extension)' != '.dll'" />
      <ResolvedFileToPublish
        Include="@(_CSharpScriptReferenceFile->Distinct())"
        RelativePath="%(_CSharpScriptReferenceFile.Filename)%(_CSharpScriptReferenceFile.Extension)"
        CopyToPublishDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>
</Project>
