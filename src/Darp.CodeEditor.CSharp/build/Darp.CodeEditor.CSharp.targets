<Project>
  <!--
    Puts the C# script language server next to the app, where CSharpLanguageServer finds it by default. Import this
    file into the app project. The app starts the server with `dotnet`, so it runs on an installed .NET 10 runtime.

      build     $(OutDir)helpers/csharp-server/      the server's build output
      publish   $(PublishDir)helpers/csharp-server/  the same files

    TODO: publish is to put the server with ReadyToRun next to a bundled runtime in helpers/dotnet, shared with the
    script runner. CSharpLanguageServerOptions.ServerPath and DotNetRoot are the seam for that layout.
  -->
  <PropertyGroup>
    <CSharpLanguageServerProject Condition="'$(CSharpLanguageServerProject)' == ''"
      >$(MSBuildThisFileDirectory)..\..\Darp.CodeEditor.CSharp.Server\Darp.CodeEditor.CSharp.Server.csproj</CSharpLanguageServerProject>
    <_CSharpLanguageServerOutput>helpers/csharp-server/</_CSharpLanguageServerOutput>
    <!-- The server is framework-dependent; the app may be self-contained or NativeAOT. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- One portable build of the server serves every configuration of the app. -->
    <_CSharpLanguageServerRemovedProperties>RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;PublishDir</_CSharpLanguageServerRemovedProperties>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds the server with the app. The app references nothing of it. -->
    <ProjectReference
      Include="$(CSharpLanguageServerProject)"
      ReferenceOutputAssembly="false"
      Private="false"
      GlobalPropertiesToRemove="$(_CSharpLanguageServerRemovedProperties)"
    />
  </ItemGroup>

  <Target Name="_GetCSharpLanguageServerFiles">
    <MSBuild
      Projects="$(CSharpLanguageServerProject)"
      Targets="GetTargetPath"
      Properties="Configuration=$(Configuration)"
      RemoveProperties="$(_CSharpLanguageServerRemovedProperties);TargetFramework"
    >
      <Output TaskParameter="TargetOutputs" ItemName="_CSharpLanguageServerTargetPath" />
    </MSBuild>
    <ItemGroup>
      <!-- Subdirectories other than runtimes/ hold builds for runtime identifiers. -->
      <_CSharpLanguageServerFile Include="%(_CSharpLanguageServerTargetPath.RootDir)%(Directory)*" />
      <_CSharpLanguageServerFile
        Include="%(_CSharpLanguageServerTargetPath.RootDir)%(Directory)runtimes\**"
        SubDirectory="runtimes/"
      />
    </ItemGroup>
  </Target>

  <Target
    Name="CopyCSharpLanguageServerToOutputDirectory"
    AfterTargets="CopyFilesToOutputDirectory"
    DependsOnTargets="_GetCSharpLanguageServerFiles"
  >
    <Copy
      SourceFiles="@(_CSharpLanguageServerFile)"
      DestinationFiles="@(_CSharpLanguageServerFile->'$(OutDir)$(_CSharpLanguageServerOutput)%(SubDirectory)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    />
  </Target>

  <Target
    Name="_AddCSharpLanguageServerToPublish"
    AfterTargets="ComputeResolvedFilesToPublishList"
    DependsOnTargets="_GetCSharpLanguageServerFiles"
  >
    <ItemGroup>
      <ResolvedFileToPublish
        Include="@(_CSharpLanguageServerFile)"
        RelativePath="$(_CSharpLanguageServerOutput)%(_CSharpLanguageServerFile.SubDirectory)%(_CSharpLanguageServerFile.RecursiveDir)%(_CSharpLanguageServerFile.Filename)%(_CSharpLanguageServerFile.Extension)"
        CopyToPublishDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>
</Project>
