<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The source-generated P/Invoke marshalling of the Windows process code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>JSON-RPC and Language Server Protocol layer for Darp.CodeEditor language servers and clients. Also starts helper processes that end with the app. NativeAOT compatible, no dependencies.</Description>
  </PropertyGroup>
</Project>
