<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <!-- The editor benchmarks render their frames, with the app theme that editors are checked against. -->
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <!-- Default: benchmark the library in this working tree. -->
  <ItemGroup Condition="'$(DarpCodeEditorBaselineVersion)' == ''">
    <ProjectReference Include="..\..\src\Darp.CodeEditor\Darp.CodeEditor.csproj" />
    <!-- The language server that the completion benchmarks ask; the baseline has no completion to ask for. -->
    <ProjectReference Include="..\..\tests\Darp.CodeEditor.Tests.FakeServer\Darp.CodeEditor.Tests.FakeServer.csproj" />
    <!-- The real C# script server, over the scripts' API of its tests; the baseline has no scripts to ask. -->
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharpScript\Darp.CodeEditor.CSharpScript.csproj" />
    <ProjectReference
      Include="..\..\tests\Darp.CodeEditor.CSharpScript.Tests.ScriptApi\Darp.CodeEditor.CSharpScript.Tests.ScriptApi.csproj"
      CSharpScriptReference="true"
    />
  </ItemGroup>
  <!-- Baseline job: benchmark a packed version of the library, without the benchmarks of code it lacks ([NotInBaseline]). -->
  <PropertyGroup Condition="'$(DarpCodeEditorBaselineVersion)' != ''">
    <DefineConstants>$(DefineConstants);BENCHMARK_BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DarpCodeEditorBaselineVersion)' != ''">
    <PackageReference Include="Darp.CodeEditor" VersionOverride="$(DarpCodeEditorBaselineVersion)" />
  </ItemGroup>
  <Import
    Project="..\..\src\Darp.CodeEditor.CSharpScript\buildTransitive\Darp.CodeEditor.CSharpScript.targets"
    Condition="'$(DarpCodeEditorBaselineVersion)' == ''"
  />
</Project>
