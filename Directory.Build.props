<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable;CS9124</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version of the packages. release-please updates it with every release. -->
    <Version>0.1.0</Version>

    <!-- NuGet packages. Which projects are packages is decided in Directory.Build.targets. -->
    <Authors>rosslight GmbH</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rosslight/Darp.CodeEditor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rosslight/Darp.CodeEditor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
