<Project Sdk="Microsoft.NET.Sdk">
  <!-- The bridge of the consumer's script API: what crosses between the app and a session. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="$(DarpStreamJsonRpcVersion)" />
  </ItemGroup>
</Project>
