<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The app's own reference to the newer version settles the conflict for the app, so only the one publish of the marked
    references sees that they can't share a version, and it must fail with NuGet's error.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishReadyToRun Condition="'$(_IsPublishing)' == 'true'">true</PublishReadyToRun>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Darp.CodeEditor.CSharpScript" Version="$(DarpCodeEditorVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <ProjectReference Include="..\ExactA\ExactA.csproj" CSharpScriptReference="true" />
    <ProjectReference Include="..\..\CompatibleB\CompatibleB.csproj" CSharpScriptReference="true" />
  </ItemGroup>
</Project>
