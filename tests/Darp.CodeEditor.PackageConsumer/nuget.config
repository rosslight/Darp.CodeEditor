<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The packages under test, which prove.sh packs from this checkout. -->
    <add key="local" value="feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="Darp.CodeEditor" />
      <package pattern="Darp.CodeEditor.CSharpScript" />
    </packageSource>
  </packageSourceMapping>
</configuration>
