<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- One warning per trim or AOT problem instead of one per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Darp.CodeEditor.Lsp\Darp.CodeEditor.Lsp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Darp.CodeEditor.Lsp.Tests\Toy\*.cs" LinkBase="Toy" />
  </ItemGroup>
  <!-- Puts luau-lsp next to the program, for the luau-lsp check. -->
  <Import Project="..\..\src\Darp.CodeEditor.Luau\buildTransitive\Darp.CodeEditor.Luau.targets" />
</Project>
