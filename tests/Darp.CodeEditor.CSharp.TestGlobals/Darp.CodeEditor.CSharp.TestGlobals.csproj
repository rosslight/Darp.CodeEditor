<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The XML docs show up in completion descriptions, hover and signature help. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The prototype's globals, so tests can check its sample script. -->
    <Compile Include="..\..\samples\Darp.CodeEditor.Demo\ScriptGlobals.cs" Link="ScriptGlobals.cs" />
  </ItemGroup>
</Project>
