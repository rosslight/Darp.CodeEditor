{
	"$schema": "vscode://schemas/color-theme",
	"name": "Marks (tests)",
	"comment": "Light+ with opaque, distinct colors for the marks that the editor draws, so that tests find them in pixels.",
	"include": "avares://Darp.CodeEditor/Themes/light_plus.json",
	"colors": {
		"editor.selectionBackground": "#FFFF00",
		"editorLineNumber.foreground": "#00FFFF",
		"editor.lineHighlightBackground": "#FF8000",
		"editorBracketMatch.background": "#FF00FF",
		"editorBracketMatch.border": "#FF00FF",
		"editorWhitespace.foreground": "#FF0000",
		"editor.findMatchBackground": "#00C000",
		"editor.findMatchHighlightBackground": "#0000FF",
		"editorError.foreground": "#FF8000",
		"editorWarning.foreground": "#00C0C0",
		"editorInfo.foreground": "#8000FF",
		"editorHint.foreground": "#008080",
		"symbolIcon.methodForeground": "#FF0080",
		"editor.snippetTabstopHighlightBackground": "#00FF80",
		"editor.snippetFinalTabstopHighlightBorder": "#804000"
	}
}
