<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <!-- Renders the headless windows, so that tests can read their pixels. -->
    <PackageReference Include="Avalonia.Skia" />
    <!-- The app theme that editors are checked against. -->
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Not in the NativeAOT tests: coverlet can't be compiled ahead of time. -->
    <PackageReference Include="coverlet.MTP" Condition="'$(_IsPublishing)' != 'true'" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>
  <ItemGroup>
    <!-- Grammars of the tests' own languages, and a color theme whose marks tests find in pixels. -->
    <AvaloniaResource Include="Languages\*.json" />
    <AvaloniaResource Include="Themes\*.json" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Darp.CodeEditor\Darp.CodeEditor.csproj" />
    <!-- The editor references it privately; tests of the connection use it directly. -->
    <ProjectReference Include="..\..\src\Darp.CodeEditor.Lsp\Darp.CodeEditor.Lsp.csproj" />
    <!-- Runs in its own process: it checks what the library does before Avalonia is set up. -->
    <ProjectReference Include="..\Darp.CodeEditor.Tests.BeforeSetup\Darp.CodeEditor.Tests.BeforeSetup.csproj" />
    <!-- The language server that the tests start. -->
    <ProjectReference Include="..\Darp.CodeEditor.Tests.FakeServer\Darp.CodeEditor.Tests.FakeServer.csproj" />
  </ItemGroup>
</Project>
