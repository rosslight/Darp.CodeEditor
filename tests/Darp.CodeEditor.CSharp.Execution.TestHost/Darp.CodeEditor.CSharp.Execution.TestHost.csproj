<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- An app that runs scripts: the tests start it as a JIT process and publish it with NativeAOT. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The AOT publish must stay free of trimming and AOT warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharp.Execution\Darp.CodeEditor.CSharp.Execution.csproj" />
    <ProjectReference Include="..\Darp.CodeEditor.CSharp.Execution.TestApi\Darp.CodeEditor.CSharp.Execution.TestApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <CSharpScriptReference Include="Darp.CodeEditor.CSharp.Execution.TestApi;StreamJsonRpc;PolyType" />
  </ItemGroup>
  <Import Project="..\..\src\Darp.CodeEditor.CSharp.Execution\build\Darp.CodeEditor.CSharp.Execution.targets" />
</Project>
