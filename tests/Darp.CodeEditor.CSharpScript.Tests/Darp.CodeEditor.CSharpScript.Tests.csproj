<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <!-- Publishing compiles the C# helpers with ReadyToRun. Only then: it would otherwise give every build a RID. -->
    <PublishReadyToRun Condition="'$(_IsPublishing)' == 'true'">true</PublishReadyToRun>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <!-- Not in the NativeAOT tests: coverlet can't be compiled ahead of time. -->
    <PackageReference Include="coverlet.MTP" Condition="'$(_IsPublishing)' != 'true'" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharpScript\Darp.CodeEditor.CSharpScript.csproj" />
    <ProjectReference Include="..\..\src\Darp.CodeEditor.CSharpScript.Runner\Darp.CodeEditor.CSharpScript.Runner.csproj" />
    <!-- The use cases run for real, on their script API. -->
    <ProjectReference Include="..\..\samples\Darp.CodeEditor.UseCases\Darp.CodeEditor.UseCases.csproj" />
    <ProjectReference
      Include="..\..\samples\Darp.CodeEditor.UseCases.ScriptApi\Darp.CodeEditor.UseCases.ScriptApi.csproj"
      CSharpScriptReference="true"
    />
    <ProjectReference
      Include="..\..\samples\Darp.CodeEditor.UseCases.ScriptApi.Runner\Darp.CodeEditor.UseCases.ScriptApi.Runner.csproj"
      CSharpScriptReference="true"
    />
    <!-- The editor references it privately; the tests read what the client reads. -->
    <ProjectReference Include="..\..\src\Darp.CodeEditor.Lsp\Darp.CodeEditor.Lsp.csproj" />
    <!-- Runs in its own process: it checks that compiling works before Avalonia is set up. -->
    <ProjectReference Include="..\Darp.CodeEditor.CSharpScript.Tests.BeforeSetup\Darp.CodeEditor.CSharpScript.Tests.BeforeSetup.csproj" />
    <ProjectReference
      Include="..\Darp.CodeEditor.CSharpScript.Tests.ScriptApi\Darp.CodeEditor.CSharpScript.Tests.ScriptApi.csproj"
      CSharpScriptReference="true"
    />
    <ProjectReference
      Include="..\Darp.CodeEditor.CSharpScript.Tests.Extra\Darp.CodeEditor.CSharpScript.Tests.Extra.csproj"
      CSharpScriptReference="true"
    />
  </ItemGroup>
  <Import Project="..\..\src\Darp.CodeEditor.CSharpScript.Runner\buildTransitive\Darp.CodeEditor.CSharpScript.Runner.targets" />
  <Import Project="..\..\src\Darp.CodeEditor.CSharpScript\buildTransitive\Darp.CodeEditor.CSharpScript.targets" />
</Project>
